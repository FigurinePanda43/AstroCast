      "visible_planets": {
        "default": "mdi:saturn"
      },
      "data_sources": {
        "default": "mdi:database-check",
        "state": {
          "degraded": "mdi:database-alert",
          "unavailable": "mdi:database-off"
        }
      },
      "favorite": {
        "default": "mdi:star"
      }
    },
    "binary_sensor": {
      "astronomical_night": {
        "default": "mdi:weather-night",
        "state": {
