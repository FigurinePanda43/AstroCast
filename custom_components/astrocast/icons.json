{
  "entity": {
    "sensor": {
      "deep_sky_tonight": {
        "default": "mdi:telescope"
      },
      "planetary_tonight": {
        "default": "mdi:orbit"
      },
      "narrowband_tonight": {
        "default": "mdi:filter-variant"
      },
