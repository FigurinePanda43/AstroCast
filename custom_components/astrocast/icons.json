        "default": "mdi:calendar-star"
      },
      "cloud_cover": {
        "default": "mdi:weather-cloudy"
      },
      "seeing": {
        "default": "mdi:blur"
      },
      "transparency": {
        "default": "mdi:eye-outline"
      },
      "dew_risk": {
        "default": "mdi:water-outline",
