  "services": {
    "get_forecast": {
      "service": "mdi:telescope"
    },
    "get_object_visibility": {
      "service": "mdi:star-search"
    },
    "add_favorite": {
      "service": "mdi:star-plus"
    },
    "remove_favorite": {
      "service": "mdi:star-minus"
    }
