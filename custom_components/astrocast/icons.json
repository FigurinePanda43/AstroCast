          "high": "mdi:water-alert"
        }
      },
      "dew_onset": {
        "default": "mdi:weather-fog"
      },
      "moon_phase": {
        "default": "mdi:moon-waxing-crescent",
        "state": {
          "new_moon": "mdi:moon-new",
          "waxing_crescent": "mdi:moon-waxing-crescent",
          "first_quarter": "mdi:moon-first-quarter",
          "waxing_gibbous": "mdi:moon-waxing-gibbous",
          "full_moon": "mdi:moon-full",
          "waning_gibbous": "mdi:moon-waning-gibbous",
          "last_quarter": "mdi:moon-last-quarter",
          "waning_crescent": "mdi:moon-waning-crescent"
        }
      },
      "moon_illumination": {
        "default": "mdi:brightness-6"
      },
      "moonrise": {
        "default": "mdi:arrow-up-thin"
      },
      "moonset": {
        "default": "mdi:arrow-down-thin"
      },
      "astronomical_dusk": {
        "default": "mdi:weather-night"
      },
      "astronomical_dawn": {
        "default": "mdi:weather-sunset-up"
      },
      "next_event": {
        "default": "mdi:calendar-clock"
      },
      "top_object": {
        "default": "mdi:star-shooting"
