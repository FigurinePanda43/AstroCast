{
  "config": {
    "step": {
      "user": {
        "title": "Add an observing site",
        "description": "Pick your observing site on the map (drag the marker). It defaults to your Home Assistant location. Leave the elevation empty to look it up automatically from a digital elevation model.",
        "data": {
          "name": "Site name",
          "location": "Location",
          "elevation": "Elevation"
        },
        "data_description": {
          "name": "For example \"Garden\" or \"Mountain site\".",
          "elevation": "Metres above sea level. Used for transparency and refraction."
        }
      },
      "observing": {
        "title": "How do you observe?",
        "description": "These settings tune the recommendations. Site elevation: {elevation} m. Everything can be changed later.",
        "data": {
          "bortle": "Sky darkness (Bortle scale)",
          "equipment": "Main equipment",
          "min_altitude": "Lowest usable altitude",
          "threshold": "\"Good conditions\" threshold"
        },
        "data_description": {
          "bortle": "Light pollution at the site. Use lightpollutionmap.info if unsure.",
          "equipment": "Used to judge which objects are bright enough to be worth it.",
          "min_altitude": "Objects lower than this (trees, buildings, haze) are ignored.",
          "threshold": "Score (0-100) above which windows are added to the calendar and the 'good conditions' sensor turns on."
        }
      },
      "reconfigure": {
        "title": "Move or rename the site",
        "description": "Drag the marker to move the site. Leave the elevation empty to look it up again.",
        "data": {
          "name": "Site name",
          "location": "Location",
          "elevation": "Elevation"
        }
      }
    },
    "error": {
      "invalid_location": "Invalid coordinates."
    },
    "abort": {
      "already_configured": "This site is already configured.",
      "reconfigure_successful": "The site has been updated."
    }
